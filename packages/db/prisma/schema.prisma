// ai-chat-platform database schema (M0)
// Money is stored as BigInt micro-US dollars; tokens as Int; structured data as Json.

datasource db {
  provider = "postgresql"
}

generator client {
  provider = "prisma-client"
  output   = "../src/generated"
}

enum Role {
  ADMIN
  USER
}

enum ConversationType {
  SINGLE
  GROUP
  CONSENSUS
  DEBATE
}

enum MessageStatus {
  PENDING
  STREAMING
  COMPLETE
  FAILED
  CANCELLED
}

enum RunStatus {
  PENDING
  RUNNING
  SUCCEEDED
  FAILED
  CANCELLED
}

enum RunPhase {
  PLANNING
  ROUND
  JUDGING
  SYNTHESIZING
}

model User {
  id            String             @id @default(cuid())
  email         String             @unique
  disabled      Boolean            @default(false)
  modelQuotas   UserModelQuota[]
  passwordHash  String
  role          Role               @default(USER)
  createdAt     DateTime           @default(now())
  updatedAt     DateTime           @updatedAt
  name          String?
  emailVerified Boolean            @default(false)
  image         String?
  sessions      Session[]
  accounts      Account[]
  conversations Conversation[]
  runs          OrchestrationRun[]
  usageLogs     UsageLog[]
  apiKeys       ApiKey[]
  modelUsageDaily ModelUsageDaily[]
  knowledgeBases KnowledgeBase[]
}

model Provider {
  id        String          @id @default(cuid())
  kind      String // ollama | openai-compatible | fake
  baseUrl   String
  enabled   Boolean         @default(true)
  createdAt DateTime        @default(now())
  updatedAt DateTime        @updatedAt
  models    ModelRegistry[]
  apiKeys   ApiKey[]
}

model ModelRegistry {
  id             String        @id @default(cuid())
  providerId     String
  provider       Provider      @relation(fields: [providerId], references: [id], onDelete: Cascade)
  baseUrl        String?
  adapter        String?
  kind           String        @default("local")
  isDefault      Boolean       @default(false)
  modelKey       String
  capabilities   Json
  pricingVersion String
  createdAt      DateTime      @default(now())
  updatedAt      DateTime      @updatedAt
  modelQuotas    UserModelQuota[]
  participants   Participant[]

  @@unique([providerId, modelKey])
}

model Conversation {
  id           String             @id @default(cuid())
  ownerId      String
  owner        User               @relation(fields: [ownerId], references: [id], onDelete: Cascade)
  title        String
  type         ConversationType
  createdAt    DateTime           @default(now())
  updatedAt    DateTime           @updatedAt
  participants Participant[]
  messages     Message[]
  runs         OrchestrationRun[]
  shareLinks   ShareLink[]
  knowledgeBases ConversationKnowledgeBase[]

  @@index([ownerId, updatedAt])
}

model Participant {
  id             String        @id @default(cuid())
  conversationId String
  conversation   Conversation  @relation(fields: [conversationId], references: [id], onDelete: Cascade)
  modelId        String
  model          ModelRegistry @relation(fields: [modelId], references: [id])
  role           String
  config         Json
  createdAt      DateTime      @default(now())
  messages       Message[]
}

model Message {
  id             String        @id @default(cuid())
  conversationId String
  conversation   Conversation  @relation(fields: [conversationId], references: [id], onDelete: Cascade)
  parentId       String?
  parent         Message?      @relation("MessageThread", fields: [parentId], references: [id], onDelete: NoAction)
  children       Message[]     @relation("MessageThread")
  participantId  String?
  participant    Participant?  @relation(fields: [participantId], references: [id], onDelete: SetNull)
  content        String        @db.Text
  status         MessageStatus
  createdAt      DateTime      @default(now())

  @@index([conversationId, createdAt])
}

model OrchestrationRun {
  id                   String                   @id @default(cuid())
  conversationId       String
  conversation         Conversation             @relation(fields: [conversationId], references: [id], onDelete: Cascade)
  ownerId              String
  owner                User                     @relation(fields: [ownerId], references: [id])
  status               RunStatus                @default(PENDING)
  phase                RunPhase?
  leaseOwner           String?
  leaseExpiresAt       DateTime?
  cancelRequested      Boolean                 @default(false)
  attempt              Int                      @default(0)
  idempotencyKey       String
  degraded             Boolean                  @default(false)
  degradationReasons   Json?
  configSnapshot       Json
  createdAt            DateTime                 @default(now())
  updatedAt            DateTime                 @updatedAt
  participantSnapshots RunParticipantSnapshot[]
  checkpoints          RunCheckpoint[]
  events               RunEvent[]
  providerCalls        ProviderCall[]
  usageLogs            UsageLog[]

  @@unique([ownerId, idempotencyKey])
}

model RunParticipantSnapshot {
  id             String           @id @default(cuid())
  runId          String
  run            OrchestrationRun @relation(fields: [runId], references: [id], onDelete: Cascade)
  seatId         String
  providerKey    String
  modelKey       String
  systemPrompt   String           @db.Text
  params         Json
  pricingVersion String
  providerCalls  ProviderCall[]
}

model RunCheckpoint {
  id        String           @id @default(cuid())
  runId     String
  run       OrchestrationRun @relation(fields: [runId], references: [id], onDelete: Cascade)
  version   Int
  stateJson Json
  createdAt DateTime         @default(now())

  @@unique([runId, version])
}

model RunEvent {
  id        String           @id @default(cuid())
  runId     String
  run       OrchestrationRun @relation(fields: [runId], references: [id], onDelete: Cascade)
  seq       Int
  type      String
  payload   Json
  createdAt DateTime         @default(now())

  @@unique([runId, seq])
}

model ProviderCall {
  id                    String                  @id @default(cuid())
  runId                 String
  run                   OrchestrationRun        @relation(fields: [runId], references: [id], onDelete: Cascade)
  participantSnapshotId String?
  participantSnapshot   RunParticipantSnapshot? @relation(fields: [participantSnapshotId], references: [id], onDelete: SetNull)
  attempt               Int
  requestHash           String                  @unique
  quotaReservation      Json?
  usage                 Json?
  error                 String?
  startedAt             DateTime                @default(now())
  endedAt               DateTime?
  usageLog              UsageLog?
}

model UsageLog {
  id         String           @id @default(cuid())
  userId     String
  user       User             @relation(fields: [userId], references: [id])
  runId      String
  run        OrchestrationRun @relation(fields: [runId], references: [id], onDelete: Cascade)
  callId     String           @unique
  call       ProviderCall     @relation(fields: [callId], references: [id])
  tokens     Int
  costMicros BigInt
  createdAt  DateTime         @default(now())
}

model ApiKey {
  id         String   @id @default(cuid())
  userId     String
  user       User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  providerId String?
  providerRef Provider? @relation(fields: [providerId], references: [id], onDelete: Cascade)
  provider   String
  ciphertext String
  // Legacy fields retained for a separate data migration into the v1 envelope.
  iv         String?
  authTag    String?
  verified   Boolean  @default(false)
  updatedAt  DateTime @updatedAt
  keyVersion Int      @default(1)
  createdAt  DateTime @default(now())

  @@unique([userId, providerId])
  @@unique([userId, provider])
}

model ShareLink {
  id              String       @id @default(cuid())
  conversationId  String
  conversation    Conversation @relation(fields: [conversationId], references: [id], onDelete: Cascade)
  tokenHash       String       @unique
  expiresAt       DateTime
  snapshotVersion Int?
  createdAt       DateTime     @default(now())
}

// ── Better Auth 支撑表（M1）─────────────────────────────
model Session {
  id        String   @id @default(cuid())
  userId    String
  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  token     String   @unique
  expiresAt DateTime
  ipAddress String?
  userAgent String?
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
}

model Account {
  id                    String    @id @default(cuid())
  userId                String
  user                  User      @relation(fields: [userId], references: [id], onDelete: Cascade)
  accountId             String
  providerId            String
  issuer                String?
  accessToken           String?
  refreshToken          String?
  idToken               String?
  accessTokenExpiresAt  DateTime?
  refreshTokenExpiresAt DateTime?
  scope                 String?
  password              String?
  createdAt             DateTime  @default(now())
  updatedAt             DateTime  @updatedAt

  @@unique([providerId, accountId])
}

model Verification {
  id         String   @id @default(cuid())
  identifier String
  value      String
  expiresAt  DateTime
  createdAt  DateTime @default(now())
  updatedAt  DateTime @updatedAt

  @@unique([identifier, value])
}

model ModelUsageDaily {
  id        String   @id @default(cuid())
  userId    String
  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  modelId   String
  date      DateTime @db.Date
  tokensIn  Int      @default(0)
  tokensOut Int      @default(0)
  reservedTokens Int @default(0)

  @@unique([userId, modelId, date])
}


enum DocumentStatus {
  PENDING
  PROCESSING
  READY
  FAILED
}

model KnowledgeBase {
  id String @id @default(cuid())
  userId String
  user User @relation(fields: [userId], references: [id], onDelete: Cascade)
  name String
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
  documents Document[]
  conversations ConversationKnowledgeBase[]
  @@index([userId, updatedAt])
}

model Document {
  id String @id @default(cuid())
  kbId String
  kb KnowledgeBase @relation(fields: [kbId], references: [id], onDelete: Cascade)
  name String
  mime String
  objectKey String @unique
  model String
  size Int
  chunkCount Int @default(0)
  status DocumentStatus @default(PENDING)
  error String?
  attempt Int @default(0)
  leaseOwner String?
  leaseExpiresAt DateTime?
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
  chunks Chunk[]
  @@index([kbId, createdAt])
  @@index([status, leaseExpiresAt])
}

model Chunk {
  id String @id @default(cuid())
  documentId String
  document Document @relation(fields: [documentId], references: [id], onDelete: Cascade)
  ordinal Int
  start Int
  end Int
  text String @db.Text
  embedding Unsupported("vector(1024)")
  createdAt DateTime @default(now())
  @@unique([documentId, ordinal])
}

model ConversationKnowledgeBase {
  conversationId String
  conversation Conversation @relation(fields: [conversationId], references: [id], onDelete: Cascade)
  kbId String
  kb KnowledgeBase @relation(fields: [kbId], references: [id], onDelete: Cascade)
  @@id([conversationId, kbId])
  @@index([kbId])
}

model UserModelQuota {
  id String @id @default(cuid())
  userId String
  modelId String
  dailyLimit Int
  user User @relation(fields: [userId], references: [id], onDelete: Cascade)
  model ModelRegistry @relation(fields: [modelId], references: [id], onDelete: Cascade)
  @@unique([userId, modelId])
}
