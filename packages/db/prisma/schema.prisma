// ai-chat-platform database schema (M0)
// Money is stored as BigInt micro-US dollars; tokens as Int; structured data as Json.

datasource db {
  provider = "postgresql"
}

generator client {
  provider = "prisma-client"
  output   = "../src/generated"
}

enum Role {
  ADMIN
  USER
}

enum ConversationType {
  SINGLE
  GROUP
  CONSENSUS
  DEBATE
}

enum MessageStatus {
  PENDING
  STREAMING
  COMPLETE
  FAILED
  CANCELLED
}

enum RunStatus {
  PENDING
  RUNNING
  SUCCEEDED
  FAILED
  CANCELLED
}

enum RunPhase {
  PLANNING
  ROUND
  JUDGING
  SYNTHESIZING
}

model User {
  id            String             @id @default(cuid())
  email         String             @unique
  disabled      Boolean            @default(false)
  modelQuotas   UserModelQuota[]
  passwordHash  String
  role          Role               @default(USER)
  createdAt     DateTime           @default(now())
  updatedAt     DateTime           @updatedAt
  name          String?
  emailVerified Boolean            @default(false)
  image         String?
  sessions      Session[]
  accounts      Account[]
  conversations Conversation[]
  runs          OrchestrationRun[]
  usageLogs     UsageLog[]
  apiKeys       ApiKey[]
  modelUsageDaily ModelUsageDaily[]
  knowledgeBases KnowledgeBase[]
}

model Provider {
  id        String          @id @default(cuid())
  kind      String // ollama | openai-compatible | fake
  baseUrl   String
  enabled   Boolean         @default(true)
  createdAt DateTime        @default(now())
  updatedAt DateTime        @updatedAt
  models    ModelRegistry[]
  apiKeys   ApiKey[]
}

model ModelRegistry {
  id             String        @id @default(cuid())
  providerId     String
  provider       Provider      @relation(fields: [providerId], references: [id], onDelete: Cascade)
  baseUrl        String?
  adapter        String?
  kind           String        @default("local")
  isDefault      Boolean       @default(false)
  modelKey       String
  capabilities   Json
  pricingVersion String
  createdAt      DateTime      @default(now())
  updatedAt      DateTime      @updatedAt
  modelQuotas    UserModelQuota[]
  participants   Participant[]

  @@unique([providerId, modelKey])
}

model Conversation {
  id           String             @id @default(cuid())
  ownerId      String
  owner        User               @relation(fields: [ownerId], references: [id], onDelete: Cascade)
  title        String
  type         ConversationType
  createdAt    DateTime           @default(now())
  updatedAt    DateTime           @updatedAt
  participants Participant[]
  messages     Message[]
  runs         OrchestrationRun[]
  shareLinks   ShareLink[]
  knowledgeBases ConversationKnowledgeBase[]

  @@index([ownerId, updatedAt])
}

model Participant {
  id             String        @id @default(cuid())
  conversationId String
  conversation   Conversation  @relation(fields: [conversationId], references: [id], onDelete: Cascade)
  modelId        String
  model          ModelRegistry @relation(fields: [modelId], references: [id])
  role           String
  config         Json
  createdAt      DateTime      @default(now())
  messages       Message[]
}

model Message {
  id             String        @id @default(cuid())
  conversationId String
  conversation   Conversation  @relation(fields: [conversationId], references: [id], onDelete: Cascade)
  parentId       String?
  parent         Message?      @relation("MessageThread", fields: [parentId], references: [id], onDelete: NoAction)
  children       Message[]     @relation("MessageThread")
  participantId  String?
  participant    Participant?  @relation(fields: [participantId], references: [id], onDelete: SetNull)
  content        String        @db.Text
  citations      Json? // Retrieval sources used for this assistant message; null for legacy/user messages
  status         MessageStatus
  createdAt      DateTime      @default(now())

  @@index([conversationId, createdAt])
}

model OrchestrationRun {
  id                   String                   @id @default(cuid())
  conversationId       String
  conversation         Conversation             @relation(fields: [conversationId], references: [id], onDelete: Cascade)
  ownerId              String
  owner                User                     @relation(fields: [ownerId], references: [id])
  status               RunStatus                @default(PENDING)
  phase                RunPhase?
  leaseOwner           String?
  leaseExpiresAt       DateTime?
  cancelRequested      Boolean                 @default(false)
  attempt              Int                      @default(0)
  idempotencyKey       String
  degraded             Boolean                  @default(false)
  degradationReasons   Json?
  configSnapshot       Json
  createdAt            DateTime                 @default(now())
  updatedAt            DateTime                 @updatedAt
  participantSnapshots RunParticipantSnapshot[]
  checkpoints          RunCheckpoint[]
  events               RunEvent[]
  providerCalls        ProviderCall[]
  usageLogs            UsageLog[]

  @@unique([ownerId, idempotencyKey])
}

model RunParticipantSnapshot {
  id             String           @id @default(cuid())
  runId          String
  run            OrchestrationRun @relation(fields: [runId], references: [id], onDelete: Cascade)
  seatId         String
  providerKey    String
  modelKey       String
  systemPrompt   String           @db.Text
  params         Json
  pricingVersion String
  providerCalls  ProviderCall[]
}

model RunCheckpoint {
  id        String           @id @default(cuid())
  runId     String
  run       OrchestrationRun @relation(fields: [runId], references: [id], onDelete: Cascade)
  version   Int
  stateJson Json
  createdAt DateTime         @default(now())

  @@unique([runId, version])
}

model RunEvent {
  id        String           @id @default(cuid())
  runId     String
  run       OrchestrationRun @relation(fields: [runId], references: [id], onDelete: Cascade)
  seq       Int
  type      String
  payload   Json
  createdAt DateTime         @default(now())

  @@unique([runId, seq])
}

model ProviderCall {
  id                    String                  @id @default(cuid())
  runId                 String
  run                   OrchestrationRun        @relation(fields: [runId], references: [id], onDelete: Cascade)
  participantSnapshotId String?
  participantSnapshot   RunParticipantSnapshot? @relation(fields: [participantSnapshotId], references: [id], onDelete: SetNull)
  attempt               Int
  requestHash           String                  @unique
  quotaReservation      Json?
  usage                 Json?
  error                 String?
  startedAt             DateTime                @default(now())
  endedAt               DateTime?
  usageLog              UsageLog?
}

model UsageLog {
  id         String           @id @default(cuid())
  userId     String
  user       User             @relation(fields: [userId], references: [id])
  runId      String
  run        OrchestrationRun @relation(fields: [runId], references: [id], onDelete: Cascade)
  callId     String           @unique
  call       ProviderCall     @relation(fields: [callId], references: [id])
  tokens     Int
  costMicros BigInt
  createdAt  DateTime         @default(now())
}

model ApiKey {
  id         String   @id @default(cuid())
  userId     String
  user       User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  providerId String?
  providerRef Provider? @relation(fields: [providerId], references: [id], onDelete: Cascade)
  provider   String
  ciphertext String
  // Legacy fields retained for a separate data migration into the v1 envelope.
  iv         String?
  authTag    String?
  verified   Boolean  @default(false)
  updatedAt  DateTime @updatedAt
  keyVersion Int      @default(1)
  createdAt  DateTime @default(now())

  @@unique([userId, providerId])
  @@unique([userId, provider])
}

model ShareLink {
  id              String       @id @default(cuid())
  conversationId  String
  conversation    Conversation @relation(fields: [conversationId], references: [id], onDelete: Cascade)
  tokenHash       String       @unique
  expiresAt       DateTime
  snapshotVersion Int?
  createdAt       DateTime     @default(now())
}

// ── Better Auth 支撑表（M1）─────────────────────────────
model Session {
  id        String   @id @default(cuid())
  userId    String
  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  token     String   @unique
  expiresAt DateTime
  ipAddress String?
  userAgent String?
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
}

model Account {
  id                    String    @id @default(cuid())
  userId                String
  user                  User      @relation(fields: [userId], references: [id], onDelete: Cascade)
  accountId             String
  providerId            String
  issuer                String?
  accessToken           String?
  refreshToken          String?
  idToken               String?
  accessTokenExpiresAt  DateTime?
  refreshTokenExpiresAt DateTime?
  scope                 String?
  password              String?
  createdAt             DateTime  @default(now())
  updatedAt             DateTime  @updatedAt

  @@unique([providerId, accountId])
}

model Verification {
  id         String   @id @default(cuid())
  identifier String
  value      String
  expiresAt  DateTime
  createdAt  DateTime @default(now())
  updatedAt  DateTime @updatedAt

  @@unique([identifier, value])
}

model ModelUsageDaily {
  id        String   @id @default(cuid())
  userId    String
  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  modelId   String
  date      DateTime @db.Date
  tokensIn  Int      @default(0)
  tokensOut Int      @default(0)
  reservedTokens Int @default(0)

  @@unique([userId, modelId, date])
}


enum DocumentStatus {
  PENDING
  PROCESSING
  READY
  FAILED
}

model KnowledgeBase {
  entities Entity[]
  entityMentions EntityMention[]
  entityRelations EntityRelation[]
  derivedFacts DerivedFact[]
  ontologyConfigs OntologyConfig[]
  id String @id @default(cuid())
  userId String
  user User @relation(fields: [userId], references: [id], onDelete: Cascade)
  name String
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
  documents Document[]
  activeGenerationId String? @unique
  activeGeneration IndexGeneration? @relation("ActiveGeneration", fields: [activeGenerationId], references: [id], onDelete: SetNull)
  generations IndexGeneration[] @relation("KbGenerations")
  sourceVersions SourceVersion[]
  compileJobs CompileJob[]
  compileOutbox CompileOutbox[]
  compileCosts CompileCostLedger[]
  chunks Chunk[]
  conversations ConversationKnowledgeBase[]
  @@index([userId, updatedAt])
}

model Document {
  entityMentions EntityMention[]
  relationEvidence RelationEvidence[]
  derivedFacts DerivedFact[]
  id String @id @default(cuid())
  kbId String
  kb KnowledgeBase @relation(fields: [kbId], references: [id], onDelete: Cascade)
  name String
  kind String @default("SOURCE") // SOURCE | WIKI_SUMMARY | WIKI_ENTITY
  mime String
  objectKey String @unique
  model String
  size Int
  chunkCount Int @default(0)
  chunkStrategy String @default("structure")
  status DocumentStatus @default(PENDING)
  error String?
  attempt Int @default(0)
  leaseOwner String?
  leaseExpiresAt DateTime?
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
  chunks Chunk[]
  sourceVersionId String?
  sourceVersion SourceVersion? @relation("CurrentSourceVersion", fields: [sourceVersionId], references: [id], onDelete: SetNull)
  sourceVersions SourceVersion[] @relation("DocumentVersions")
  summaryFacts SummaryFact[] @relation("SummaryFacts")
  sourceFacts SummaryFact[] @relation("SourceFacts")
  compileArtifacts CompileJob[] @relation("CompileArtifact")
  @@index([kbId, createdAt])
  @@index([status, leaseExpiresAt])
}

model Chunk {
  entityMentions EntityMention[]
  relationEvidence RelationEvidence[]
  id String @id @default(cuid())
  kbId String
  kb KnowledgeBase @relation(fields: [kbId], references: [id], onDelete: Cascade)
  generationId String?
  generation IndexGeneration? @relation(fields: [generationId], references: [id], onDelete: Cascade)
  documentId String
  document Document @relation(fields: [documentId], references: [id], onDelete: Cascade)
  parentId String?
  parent Chunk? @relation("ChildChunks", fields: [parentId], references: [id], onDelete: SetNull, onUpdate: Cascade)
  children Chunk[] @relation("ChildChunks")
  evidenceFacts SummaryFact[]
  headingPath String? // JSON-serialized string[] produced by the chunker; display metadata only
  kind String @default("CHILD") // PARENT | CHILD | STANDALONE
  ordinal Int
  start Int
  end Int
  text String @db.Text
  // Database-generated full-text column: GENERATED ALWAYS AS (to_tsvector('simple', text)) STORED.
  // Prisma cannot express generated columns, so the DDL in the migration (…_m9_rag_quality) is the
  // source of truth; the app never writes this column.
  tsv Unsupported("tsvector")?
  embedding Unsupported("vector(1024)")
  createdAt DateTime @default(now())
  @@unique([documentId, generationId, ordinal])
  @@index([kbId, generationId])
  @@index([parentId], map: "Chunk_parentId_idx")
  // GIN index chunk_tsv_idx ON (tsv) also lives only in the migration SQL; Prisma cannot index
  // Unsupported columns.
}

model ConversationKnowledgeBase {
  conversationId String
  conversation Conversation @relation(fields: [conversationId], references: [id], onDelete: Cascade)
  kbId String
  kb KnowledgeBase @relation(fields: [kbId], references: [id], onDelete: Cascade)
  @@id([conversationId, kbId])
  @@index([kbId])
}

model UserModelQuota {
  id String @id @default(cuid())
  userId String
  modelId String
  dailyLimit Int
  user User @relation(fields: [userId], references: [id], onDelete: Cascade)
  model ModelRegistry @relation(fields: [modelId], references: [id], onDelete: Cascade)
  @@unique([userId, modelId])
}


enum IndexGenerationStatus {
  BUILDING
  ACTIVE
  RETIRED
  FAILED
}

model SourceVersion {
  entityMentions EntityMention[]
  relationEvidence RelationEvidence[]
  id String @id @default(cuid())
  kbId String
  kb KnowledgeBase @relation(fields: [kbId], references: [id], onDelete: Cascade)
  documentId String
  document Document @relation("DocumentVersions", fields: [documentId], references: [id], onDelete: Cascade)
  currentDocuments Document[] @relation("CurrentSourceVersion")
  contentHash String
  parserVersion String
  normalizerVersion String
  createdAt DateTime @default(now())
  compileJobs CompileJob[]
  @@unique([documentId, contentHash])
}

model IndexGeneration {
  entityMentions EntityMention[]
  entityRelations EntityRelation[]
  derivedFacts DerivedFact[]
  id String @id @default(cuid())
  kbId String
  kb KnowledgeBase @relation("KbGenerations", fields: [kbId], references: [id], onDelete: Cascade)
  activeFor KnowledgeBase? @relation("ActiveGeneration")
  status IndexGenerationStatus @default(BUILDING)
  configSnapshot Json
  documentCount Int @default(0)
  chunkCount Int @default(0)
  createdAt DateTime @default(now())
  activatedAt DateTime?
  retiredAt DateTime?
  chunks Chunk[]
  compileJobs CompileJob[]
  @@index([kbId, status])
}

model CompileJob {
  id String @id @default(cuid())
  kbId String
  kb KnowledgeBase @relation(fields: [kbId], references: [id], onDelete: Cascade)
  sourceVersionId String
  sourceVersion SourceVersion @relation(fields: [sourceVersionId], references: [id], onDelete: Cascade)
  generationId String
  generation IndexGeneration @relation(fields: [generationId], references: [id], onDelete: Cascade)
  artifactType String
  model String
  promptVersion String
  schemaVersion String
  status String @default("PENDING")
  attempt Int @default(0)
  maxAttempts Int @default(2)
  idempotencyKey String @unique
  leaseOwner String?
  leaseExpiresAt DateTime?
  lastError String?
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
  artifactDocumentId String?
  artifactDocument Document? @relation("CompileArtifact", fields: [artifactDocumentId], references: [id], onDelete: SetNull)
  costs CompileCostLedger[]
}

model CompileOutbox {
  id String @id @default(cuid())
  kbId String
  kb KnowledgeBase @relation(fields: [kbId], references: [id], onDelete: Cascade)
  documentId String
  sourceVersionId String
  generationId String
  eventType String
  createdAt DateTime @default(now())
  processedAt DateTime?
  @@unique([documentId, sourceVersionId, generationId, eventType])
  @@index([processedAt, createdAt])
}

model CompileCostLedger {
  id String @id @default(cuid())
  kbId String
  kb KnowledgeBase @relation(fields: [kbId], references: [id], onDelete: Cascade)
  compileJobId String
  compileJob CompileJob @relation(fields: [compileJobId], references: [id], onDelete: Cascade)
  model String
  operation String
  inputTokens Int?
  outputTokens Int?
  costUsd Decimal? @db.Decimal(12, 6)
  priceVersion String
  attempt Int
  status String
  elapsedMs Int?
  requestDedupKey String @unique
  createdAt DateTime @default(now())
  @@index([kbId, createdAt])
}

model SummaryFact {
  id String @id @default(cuid())
  summaryDocumentId String
  summaryDocument Document @relation("SummaryFacts", fields: [summaryDocumentId], references: [id], onDelete: Cascade)
  sourceDocumentId String
  sourceDocument Document @relation("SourceFacts", fields: [sourceDocumentId], references: [id], onDelete: Cascade)
  sourceChunkId String
  sourceChunk Chunk @relation(fields: [sourceChunkId], references: [id], onDelete: Cascade)
  claim String @db.Text
  quote String @db.Text
  spanStart Int
  spanEnd Int
  @@index([summaryDocumentId])
}

model Entity {
  id String @id @default(cuid())
  kbId String
  canonicalName String
  type String
  context String
  createdAt DateTime @default(now())
  kb KnowledgeBase @relation(fields: [kbId], references: [id], onDelete: Cascade)
  aliases EntityAlias[]
  mentions EntityMention[]
  subjectRelations EntityRelation[] @relation("Subject")
  objectRelations EntityRelation[] @relation("Object")
  derivedFacts DerivedFact[]
  @@index([kbId])
}

model EntityAlias {
  id String @id @default(cuid())
  entityId String
  alias String
  normalized String
  entity Entity @relation(fields: [entityId], references: [id], onDelete: Cascade)
  @@index([normalized])
  @@index([entityId])
}

model EntityMention {
  id String @id @default(cuid())
  kbId String
  generationId String
  entityId String
  documentId String
  chunkId String
  sourceVersionId String
  start Int
  end Int
  evidenceText String
  evidenceTextHash String
  createdAt DateTime @default(now())
  kb KnowledgeBase @relation(fields: [kbId], references: [id], onDelete: Cascade)
  generation IndexGeneration @relation(fields: [generationId], references: [id], onDelete: Cascade)
  entity Entity @relation(fields: [entityId], references: [id], onDelete: Cascade)
  document Document @relation(fields: [documentId], references: [id], onDelete: Cascade)
  chunk Chunk @relation(fields: [chunkId], references: [id], onDelete: Cascade)
  sourceVersion SourceVersion @relation(fields: [sourceVersionId], references: [id], onDelete: Cascade)
  @@unique([chunkId, entityId, start])
  @@index([kbId, generationId])
  @@index([entityId])
}

model EntityRelation {
  id String @id @default(cuid())
  kbId String
  generationId String
  schemaVersion String
  subjectId String
  predicate String
  objectId String
  timeQualifier String?
  conditionQualifier String?
  createdAt DateTime @default(now())
  kb KnowledgeBase @relation(fields: [kbId], references: [id], onDelete: Cascade)
  generation IndexGeneration @relation(fields: [generationId], references: [id], onDelete: Cascade)
  subject Entity @relation("Subject", fields: [subjectId], references: [id], onDelete: Cascade)
  object Entity @relation("Object", fields: [objectId], references: [id], onDelete: Cascade)
  evidence RelationEvidence[]
  derivedFacts DerivedFact[]
  @@unique([generationId, subjectId, predicate, objectId, timeQualifier, conditionQualifier], map: "EntityRelation_fact_key")
  @@index([kbId, generationId])
  @@index([subjectId, predicate])
  @@index([objectId])
}

model RelationEvidence {
  id String @id @default(cuid())
  relationId String
  documentId String
  sourceVersionId String
  chunkId String
  start Int
  end Int
  evidenceText String
  evidenceTextHash String
  createdAt DateTime @default(now())
  relation EntityRelation @relation(fields: [relationId], references: [id], onDelete: Cascade)
  document Document @relation(fields: [documentId], references: [id], onDelete: Cascade)
  sourceVersion SourceVersion @relation(fields: [sourceVersionId], references: [id], onDelete: Cascade)
  chunk Chunk @relation(fields: [chunkId], references: [id], onDelete: Cascade)
  @@index([relationId])
  @@index([documentId])
  @@index([chunkId])
}

model DerivedFact {
  id String @id @default(cuid())
  kbId String
  generationId String
  claim String
  entityId String?
  relationId String?
  sourceDocumentIds String[]
  evidenceJson Json
  wikidocId String?
  createdAt DateTime @default(now())
  kb KnowledgeBase @relation(fields: [kbId], references: [id], onDelete: Cascade)
  generation IndexGeneration @relation(fields: [generationId], references: [id], onDelete: Cascade)
  entity Entity? @relation(fields: [entityId], references: [id], onDelete: SetNull)
  relation EntityRelation? @relation(fields: [relationId], references: [id], onDelete: SetNull)
  wikidoc Document? @relation(fields: [wikidocId], references: [id], onDelete: SetNull)
  @@index([kbId, generationId])
}

model OntologyConfig {
  id String @id @default(cuid())
  kbId String
  version String
  schemaJson Json
  createdAt DateTime @default(now())
  kb KnowledgeBase @relation(fields: [kbId], references: [id], onDelete: Cascade)
  @@unique([kbId, version])
}

// Vault is an independent root; no relation to the legacy KB table family.
model VaultSource {
  id String @id @default(cuid())
  vaultId String @default("default") @map("vault_id")
  familyId String @map("family_id")
  title String
  mimeType String @map("mime_type")
  filePath String @map("file_path")
  sha256 String @db.VarChar(64)
  bytes BigInt
  addedBy String @default("user") @map("added_by")
  createdAt DateTime @default(now()) @map("created_at")
  family VaultSourceFamily @relation(fields: [familyId], references: [id], onDelete: Cascade, onUpdate: Cascade)
  evidence VaultEvidence[]
  entityCandidates VaultEntityCandidate[]
  @@unique([vaultId, familyId, sha256])
}

model VaultSourceFamily {
  id String @id @default(cuid())
  vaultId String @default("default") @map("vault_id")
  familyKey String @map("family_key")
  title String
  firstSeenAt DateTime @default(now()) @map("first_seen_at")
  sources VaultSource[]
  @@unique([vaultId, familyKey])
}

model VaultPage {
  id String @id @default(cuid())
  vaultId String @default("default") @map("vault_id")
  pageId String @map("page_id") // Concept slug
  kind String // source_summary | concept | comparison | answer | report
  title String
  revision String // rev-NNN
  filePath String @map("file_path")
  ontologyVersion String @map("ontology_version")
  createdAt DateTime @default(now()) @map("created_at")
  updatedAt DateTime @updatedAt @map("updated_at")
  assertions VaultAssertion[]
  @@unique([vaultId, pageId])
}

model VaultAssertion {
  id String @id @default(cuid()) // Application supplies the asr_ prefix.
  vaultId String @default("default") @map("vault_id")
  subjectId String @map("subject_id")
  predicate String
  objectId String? @map("object_id") // Application supplies exactly one of objectId/value.
  value String?
  polarity Boolean
  conditions String? // Serialized JSON
  validFrom String? @map("valid_from")
  validTo String? @map("valid_to")
  status String // candidate | supported | contested | superseded | invalid
  origin String // sourced | inferred
  ruleId String? @map("rule_id")
  ruleVersion String? @map("rule_version")
  revision String
  pageId String? @map("page_id")
  ontologyVersion String @map("ontology_version")
  createdAt DateTime @default(now()) @map("created_at")
  updatedAt DateTime @updatedAt @map("updated_at")
  page VaultPage? @relation(fields: [vaultId, pageId], references: [vaultId, pageId], onDelete: Cascade, onUpdate: Cascade)
  evidence VaultEvidence[]
  @@index([vaultId, subjectId])
  @@index([vaultId, predicate])
  @@index([vaultId, status])
}

model VaultEvidence {
  id String @id @default(cuid())
  vaultId String @default("default") @map("vault_id")
  assertionId String @map("assertion_id")
  sourceId String @map("source_id")
  sourceSha256 String @map("source_sha256") @db.VarChar(64)
  locatorKind String @map("locator_kind") // page | section | offset | time
  locatorJson String @map("locator_json")
  quote String @db.VarChar(500)
  stance String // supports | contradicts
  createdAt DateTime @default(now()) @map("created_at")
  assertion VaultAssertion @relation(fields: [assertionId], references: [id], onDelete: Cascade, onUpdate: Cascade)
  source VaultSource @relation(fields: [sourceId], references: [id], onDelete: Cascade, onUpdate: Cascade)
  @@index([assertionId])
  @@index([sourceId])
}

model VaultRelease {
  id String @id @default(cuid())
  vaultId String @default("default") @map("vault_id")
  revision String // rev-NNN
  ontologyVersion String @map("ontology_version")
  rulesVersion String @map("rules_version")
  filesJson Json @map("files_json") // Array<{path, sha256}>
  baselineHash String @map("baseline_hash")
  releasedAt DateTime @default(now()) @map("released_at")
  status String // pending | committed | aborted
  gitCommit String? @map("git_commit")
  @@unique([vaultId, revision])
}

model VaultEntityCandidate {
  id String @id @default(cuid())
  vaultId String @default("default") @map("vault_id")
  canonicalName String @map("canonical_name")
  type String // One of the seven ontology entity types
  status String // candidate | promoted | merged | rejected
  promotedPageId String? @map("promoted_page_id")
  firstSourceId String @map("first_source_id")
  familyIdsJson Json @map("family_ids_json")
  aliasesJson Json @map("aliases_json")
  createdAt DateTime @default(now()) @map("created_at")
  updatedAt DateTime @updatedAt @map("updated_at")
  firstSource VaultSource @relation(fields: [firstSourceId], references: [id], onDelete: Cascade, onUpdate: Cascade)
  @@unique([vaultId, canonicalName, type])
  @@index([vaultId, status])
}
