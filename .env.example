# ai-chat-platform .env 模板 —— 复制为 .env 后填入真实值；.env 永不提交
# 数据库 / 缓存 / 对象存储（Docker 卷位于 D:\ai-chat-data）
POSTGRES_USER=aichat
POSTGRES_PASSWORD=change-me-local-only
POSTGRES_DB=aichat
DATABASE_URL=postgresql://aichat:change-me-local-only@localhost:5432/aichat
REDIS_URL=redis://localhost:6379
MINIO_ROOT_USER=minioadmin
MINIO_ROOT_PASSWORD=change-me-local-only
S3_ENDPOINT=http://localhost:9000
S3_BUCKET=ai-chat-platform

# 本地模型服务（宿主机 Ollama，不进 Docker；必须用 127.0.0.1，本机 ::1 上有空库实例）
OLLAMA_BASE_URL=http://127.0.0.1:11434

# API Key 加密（AES-256-GCM）：32 字节 base64，示例值必须替换
ENCRYPTION_KEY=change-me-base64-32-bytes-key-material

# DeepSeek 云端模型（对话/推理）
DEEPSEEK_API_KEY=
DEEPSEEK_BASE_URL=https://api.deepseek.com/v1
# 本地默认模型（Ollama 模型标识，如 qwen3:0.6b）
LOCAL_DEFAULT_MODEL=
# 种子管理员初始密码（首次启动建号用，生产必须替换）
SEED_ADMIN_PASSWORD=

# Better Auth（apps/web）：生产必须替换为 32+ 字节随机串（openssl rand -base64 32）
BETTER_AUTH_SECRET=change-me-random-32-bytes
AUTH_SECRET=change-me-random-32-bytes
# 本地冒烟时同时取消下面两项的注释；生产不得设置 AICHAT_LOCAL_SMOKE
# AICHAT_LOCAL_SMOKE=1
# BETTER_AUTH_URL=http://127.0.0.1:3100
# 生产构建与运行时均须显式设置 BETTER_AUTH_URL 为应用自身的 HTTPS origin
# BETTER_AUTH_URL=https://chat.example.com
NEXT_PUBLIC_APP_URL=http://localhost:3000
