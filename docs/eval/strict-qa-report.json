    {
      "id": "e192eb83-6ec0-4433-8fbb-d13ea9d85cfd",
      "questionType": "fact",
      "answerable": true,
      "correct": true,
      "actual": {
        "kind": "sourced",
        "answer": "RAG（Retrieval-Augmented Generation，检索增强生成）是一种将检索与生成结合的自然语言处理技术，主要应用于大规模语言模型（如GPT）与信息检索系统（如搜索引擎）的集成。[asr_7dec4b65-77c7-4a37-a5b3-366b55fca6c1]",
        "citations": [
          {
            "assertionId": "asr_7dec4b65-77c7-4a37-a5b3-366b55fca6c1",
            "quote": "RAG（Retrieval-Augmented Generation，检索增强生成）是一种将检索与生成结\n合的自然语言处理技术，主要应用于大规模语言模型（如GPT）与信息检索系统（如\n搜索引擎）的集成。",
            "locator": {
              "kind": "page",
              "page": 1
