{
  "name": "ai-chat-platform",
  "private": true,
  "version": "0.0.1",
  "type": "module",
  "engines": {
    "node": "24.16.0",
    "pnpm": "10.34.5"
  },
  "packageManager": "pnpm@10.34.5",
  "pnpm": {
    "onlyBuiltDependencies": [
      "@prisma/engines",
      "prisma"
    ]
  },
  "scripts": {
    "lint": "echo 'lint: not configured yet (M1)'",
    "typecheck": "echo 'typecheck: not configured yet (M1)'",
    "test": "vitest run && pnpm --filter @aichat/web test",
    "test:integration": "pnpm --filter @aichat/web test:integration",
    "test:e2e": "node tests/smoke-login-page.cjs",
    "build": "echo 'build: not configured yet (M1)'",
    "compose:up": "docker compose -f infra/compose.yaml --env-file .env up -d",
    "compose:down": "docker compose -f infra/compose.yaml --env-file .env down",
    "dev:web": "pnpm --filter @aichat/web dev",
    "dev:worker": "pnpm --filter @aichat/worker dev",
    "dev:all": "node scripts/dev-all.mjs"
  },
  "devDependencies": {
    "dotenv": "^17.4.2",
    "prisma": "7.0.0",
    "puppeteer-core": "^25.11.0",
    "tsx": "^4.23.13",
    "vitest": "3.2.4",
    "zod": "4.1.5"
  }
}
